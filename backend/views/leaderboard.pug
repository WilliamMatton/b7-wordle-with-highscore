extends layouts/main.pug

block pageTitle
  title= title

block pageStyle
  link(rel="stylesheet", type="text/css" href="/static/static.css")

block content
  - const filterLength = filterData.length != null
  - const filterRepeat = filterData.repeat != null
  - let n = 1
  main
    div(class="leaderboard")
      h1(class="lbHeading") Leaderboard
      form(class="lbFilterForm" method="GET")
        select(class="lbLengthSelect" name="length" onchange="this.form.submit()")
          option(value="" selected=!filterLength) All
          while n <= maxLength
            option(value=n selected=filterLength && filterData.length == n)= n++
        select(class="lbRepeatSelect" name="repeating" onchange="this.form.submit()")
          option(value="" selected=!filterRepeat) All
          option(value="true" selected=filterRepeat && filterData.repeat) True
          option(value="false" selected=filterRepeat && !filterData.repeat) False
      ul(class="scoreList")
        each data in scoreData
          include ./includes/scoreItem.pug
extends layouts/main.pug

block pageTitle
  title= title

block pageStyle
  link(rel="stylesheet", type="text/css" href="/static/static.css")

block content
  - const filterLength = filterData.length != null
  - const filterRepeat = filterData.repeat != null
  main
    div(class="leaderboard")
      h1(class="lbHeading") Leaderboard
      div(class="lbFilterMenu")
        h2(class="lbFilterHeading") Filters
        form(class="lbFilterForm" method="GET")
          div(class="lbFilterLHS")
            label(class="lbSelectLabel" for="length") Word length
            select(class="lbLengthSelect" name="length" onchange="this.form.submit()")
              option(class="lengthOption" value="" selected=!filterLength) All
              each num in lengths
                option(class="lengthOption" value=num selected=filterLength && filterData.length == num)= num
          div(class="lbFilterRHS")
            label(class="lbSelectLabel" for="repeating") Repeat letters allowed
            select(class="lbRepeatSelect" name="repeating" onchange="this.form.submit()")
              option(class="repeatOption" value="" selected=!filterRepeat) All
              option(class="repeatOption" value="true" selected=filterRepeat && filterData.repeat) True
              option(class="repeatOption" value="false" selected=filterRepeat && !filterData.repeat) False
      ul(class="scoreList")
        each data in scoreData
          include ./includes/scoreItem.pug